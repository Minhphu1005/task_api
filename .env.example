# Application
APP_NAME=TaskHub API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database (PostgreSQL 16 async)
DATABASE_URL=postgresql+asyncpg://taskhub:taskhub@localhost:5432/taskhub
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# Security & JWT
SECRET_KEY=change-me-to-a-strong-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email notifications (optional SMTP; logs when disabled)
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@taskhub.local
